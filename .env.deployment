# Deployment Environment Variables Template
# Copy this file to .env.deployment and fill in your values
# Used when deploying backend services

# ============================================
# SUPABASE CONFIGURATION
# ============================================
SUPABASE_URL=https://kwmohdwibtxlspfqarje.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here
SUPABASE_DB_PASSWORD=your-database-password-here

# ============================================
# SECURITY & AUTHENTICATION
# ============================================
JWT_SECRET=your-jwt-secret-key-minimum-32-characters-long

# ============================================
# AI SERVICES
# ============================================
OPENAI_API_KEY=sk-your-openai-api-key-here

# ============================================
# EMAIL CONFIGURATION
# ============================================
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASSWORD=your-sendgrid-api-key-here
SMTP_FROM_EMAIL=noreply@safiri.com

# ============================================
# GOOGLE CLOUD (for Cloud Run deployment)
# ============================================
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_REGION=us-central1

# ============================================
# SERVICE URLS
# ============================================
# Set these after deploying services
B2B_BACKEND_URL=https://your-b2b-service.run.app
AI_CORE_SERVICE_URL=https://your-ai-core-service.run.app

# ============================================
# OPTIONAL CONFIGURATION
# ============================================
# ENVIRONMENT=production
# LOG_LEVEL=info
# CACHE_TTL=3600
# MAX_CONNECTIONS=100
